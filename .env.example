# AirMCP Solo - environment variables
# Salin file ini jadi .env lalu isi key yang ada

# OpenAI (primary)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Deepseek (reasoning / cost-effective)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Hermes 3 via OpenRouter (open-weights)
HERMES_API_KEY=
OPENROUTER_API_KEY=
HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b

# Production hardening (aktifkan hanya setelah token diisi)
AIRMCP_PRODUCTION=0
AIRMCP_DASHBOARD_TOKEN=
AIRMCP_HOST=127.0.0.1
AIRMCP_PORT=8765
AIRMCP_RATE_LIMIT_PER_MINUTE=240
# Windows: pisahkan beberapa root dengan titik koma (;). Linux/macOS: titik dua (:).
AIRMCP_ALLOWED_ROOTS=
# Default production memblokir tool berisiko. Isi daftar yang benar-benar dibutuhkan.
AIRMCP_ALLOWED_DANGEROUS_TOOLS=
AIRMCP_ALLOW_PRIVATE_NETWORK=0
AIRMCP_NO_BROWSER=0
